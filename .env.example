# Airtable Credentials
# Get your API key from https://airtable.com/create/tokens (Requires read access to records)
AIRTABLE_API_KEY="patYourPersonalAccessTokenHere"

# The Base ID starts with 'app' (find this in the Airtable API docs or URL)
AIRTABLE_BASE_ID="appYourBaseIdHere"

# The exact name of your table (e.g., "tbl-development_only" or "Plants")
AIRTABLE_TABLE_NAME="Your Table Name"

# TRMNL Credentials
# Create a Private Plugin in your TRMNL dashboard, click 'Save', and copy the Webhook URL
TRMNL_WEBHOOK_URL="https://trmnl.com/api/custom_plugins/your_uuid_here"
